# ============================================================================
# Variables d'environnement - SID Nimba Distribution
# Copier ce fichier en ".env" et adapter les valeurs si besoin.
# ============================================================================

# --- PostgreSQL (conteneur unique hébergeant plusieurs bases) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

POSTGRES_DB_ERP=erp_source
POSTGRES_DB_DWH=dwh
POSTGRES_DB_AIRFLOW=airflow
POSTGRES_DB_SUPERSET=superset

# --- Airflow ---
AIRFLOW_UID=50000
# Générée pour cet exemple avec `python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
# -> régénérez-en une nouvelle pour un déploiement réel.
AIRFLOW__CORE__FERNET_KEY=Galqb0sXLG-jJI-bhsf2EareW8D8qIxGI0H9jxomKUs=
AIRFLOW__WEBSERVER__SECRET_KEY=change_moi_en_production
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@nimba-distribution.example

# --- Superset ---
SUPERSET_SECRET_KEY=change_moi_en_production
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@nimba-distribution.example

# --- Module optionnel : API de taux de change ---
# Laisser vide pour désactiver l'appel réseau et utiliser le repli statique
# fourni dans data/raw/json/taux_change_fallback.json
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/EUR
